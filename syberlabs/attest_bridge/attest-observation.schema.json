{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:syberlabs:schemas:attest-observation:v1",
  "title": "SyberWork Attest observation payload",
  "description": "Observation envelope for opaque Attest records. It grants no SyberWork authority and is never destination proof.",
  "allOf": [
    {
      "type": "object",
      "required": ["key", "value", "source", "version", "actor", "verified"],
      "properties": {
        "key": {"enum": ["attest.run_receipt", "attest.authority_decision", "attest.handoff_package"]},
        "value": {"type": "object"},
        "source": {"const": "attest"},
        "version": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1},
        "verified": {"const": false}
      },
      "additionalProperties": false
    },
    {
      "oneOf": [
        {
          "properties": {
            "key": {"const": "attest.run_receipt"},
            "value": {"$ref": "#/$defs/run_receipt"}
          }
        },
        {
          "properties": {
            "key": {"const": "attest.authority_decision"},
            "value": {"$ref": "#/$defs/authority_decision"}
          }
        },
        {
          "properties": {
            "key": {"const": "attest.handoff_package"},
            "value": {"$ref": "#/$defs/handoff_package"}
          }
        }
      ]
    }
  ],
  "$defs": {
    "opaque_record": {
      "type": "object",
      "required": ["kind", "payload"],
      "properties": {
        "kind": {"type": "string"},
        "payload": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "run_receipt": {
      "allOf": [
        {"$ref": "#/$defs/opaque_record"},
        {
          "properties": {
            "kind": {"const": "run_receipt"},
            "payload": {"$ref": "#/$defs/attest_receipt_v0"}
          }
        }
      ]
    },
    "authority_decision": {
      "allOf": [
        {"$ref": "#/$defs/opaque_record"},
        {"properties": {"kind": {"const": "authority_decision"}}}
      ]
    },
    "handoff_package": {
      "allOf": [
        {"$ref": "#/$defs/opaque_record"},
        {"properties": {"kind": {"const": "handoff_package"}}}
      ]
    },
    "attest_receipt_v0": {
      "type": "object",
      "required": [
        "schema", "case_id", "created_at", "doc", "claim", "authority",
        "proposal", "approval", "evidence", "handoff", "disposition", "verified"
      ],
      "properties": {
        "schema": {"const": "attest.receipt/v0"},
        "case_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1},
        "doc": {"$ref": "#/$defs/doc"},
        "claim": {"$ref": "#/$defs/claim"},
        "authority": {"$ref": "#/$defs/authority"},
        "proposal": {"$ref": "#/$defs/proposal"},
        "approval": {"$ref": "#/$defs/approval"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "handoff": {},
        "disposition": {},
        "verified": {"const": false}
      },
      "additionalProperties": true
    },
    "doc": {"$ref": "#/$defs/required_object_doc"},
    "claim": {"$ref": "#/$defs/required_object_claim"},
    "authority": {"$ref": "#/$defs/required_object_authority"},
    "proposal": {"$ref": "#/$defs/required_object_proposal"},
    "approval": {"$ref": "#/$defs/required_object_approval"},
    "evidence": {"$ref": "#/$defs/required_object_evidence"},
    "required_object_doc": {
      "type": "object", "required": ["source", "sha256_before", "sha256_after"],
      "properties": {"source": {}, "sha256_before": {}, "sha256_after": {}}, "additionalProperties": true
    },
    "required_object_claim": {
      "type": "object", "required": ["id", "kind", "lines", "text", "expects_before", "expects_after"],
      "properties": {"id": {}, "kind": {}, "lines": {}, "text": {}, "expects_before": {}, "expects_after": {}}, "additionalProperties": true
    },
    "required_object_authority": {
      "type": "object", "required": ["policy", "decision", "rule"],
      "properties": {"policy": {}, "decision": {}, "rule": {}}, "additionalProperties": true
    },
    "required_object_proposal": {
      "type": "object", "required": ["agent", "patch_sha256", "patch"],
      "properties": {"agent": {}, "patch_sha256": {}, "patch": {}}, "additionalProperties": true
    },
    "required_object_approval": {
      "type": "object", "required": ["actor", "proposal_sha256"],
      "properties": {"actor": {}, "proposal_sha256": {}}, "additionalProperties": true
    },
    "required_object_evidence": {
      "type": "object", "required": ["before", "after"],
      "properties": {"before": {}, "after": {}}, "additionalProperties": true
    }
  }
}
