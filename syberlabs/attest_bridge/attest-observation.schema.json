{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:syberlabs:schemas:attest-observation:v1",
  "title": "SyberWork Attest observation payload",
  "description": "Observation envelope for Attest records. The receipt remains observation data; its contract projection does not set the observation's verified flag or reconcile SyberWork effects.",
  "type": "object",
  "required": ["key", "value", "source", "version", "actor", "verified"],
  "properties": {
    "key": {"enum": ["attest.run_receipt", "attest.authority_decision", "attest.handoff_package"]},
    "value": {"type": "object"},
    "source": {"const": "attest"},
    "version": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "verified": {"const": false}
  },
  "oneOf": [
    {
      "properties": {
        "key": {"const": "attest.run_receipt"},
        "value": {"$ref": "#/$defs/run_receipt"}
      }
    },
    {
      "properties": {
        "key": {"const": "attest.authority_decision"},
        "value": {"$ref": "#/$defs/authority_decision"}
      }
    },
    {
      "properties": {
        "key": {"const": "attest.handoff_package"},
        "value": {"$ref": "#/$defs/handoff_package"}
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "run_receipt": {
      "type": "object",
      "required": ["kind", "payload"],
      "properties": {
        "kind": {"const": "run_receipt"},
        "payload": {"$ref": "#/$defs/attest_receipt_v0"},
        "projection": {"$ref": "#/$defs/receipt_projection"}
      },
      "additionalProperties": false
    },
    "receipt_projection": {
      "type": "object",
      "properties": {
        "implementation": {
          "type": "object",
          "required": ["ticket_title", "patch_sha256"],
          "properties": {
            "ticket_title": {"type": "string"},
            "patch_sha256": {"type": "string"}
          },
          "additionalProperties": false
        },
        "destination_verification": {
          "type": "object",
          "required": ["status", "method", "reported_by"],
          "properties": {
            "status": {"const": "verified"},
            "method": {"const": "kane_recheck"},
            "reported_by": {"const": "attest.receipt/v0 evidence.after.status"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "authority_decision": {
      "type": "object",
      "required": ["kind", "payload"],
      "properties": {
        "kind": {"const": "authority_decision"},
        "payload": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "handoff_package": {
      "type": "object",
      "required": ["kind", "payload"],
      "properties": {
        "kind": {"const": "handoff_package"},
        "payload": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "attest_receipt_v0": {
      "type": "object",
      "required": [
        "schema", "case_id", "created_at", "doc", "claim", "authority",
        "proposal", "approval", "evidence", "handoff", "disposition", "verified"
      ],
      "properties": {
        "schema": {"const": "attest.receipt/v0"},
        "case_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1},
        "doc": {"$ref": "#/$defs/doc"},
        "claim": {"$ref": "#/$defs/claim"},
        "authority": {"$ref": "#/$defs/authority"},
        "proposal": {"$ref": "#/$defs/proposal"},
        "approval": {"$ref": "#/$defs/approval"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "handoff": {},
        "disposition": {"enum": ["repaired", "handoff_implementation", "implemented", "unresolved"]},
        "verified": {"const": false},
        "ticket": {"$ref": "#/$defs/ticket"},
        "app": {"$ref": "#/$defs/app"},
        "worker": {"type": "object", "additionalProperties": true}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "implemented"}}, "required": ["disposition"]},
          "then": {"required": ["ticket", "app"]}
        }
      ],
      "additionalProperties": false
    },
    "doc": {
      "type": "object",
      "required": ["source", "sha256_before", "sha256_after"],
      "properties": {"source": {}, "sha256_before": {}, "sha256_after": {}},
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": ["id", "kind", "lines", "text", "expects_before", "expects_after"],
      "properties": {"id": {}, "kind": {}, "lines": {}, "text": {}, "expects_before": {}, "expects_after": {}},
      "additionalProperties": true
    },
    "authority": {
      "type": "object",
      "required": ["policy", "decision", "rule"],
      "properties": {
        "policy": {},
        "decision": {"enum": ["doc_repair_allowed", "doc_repair_denied", "implementation_required"]},
        "rule": {}
      },
      "additionalProperties": true
    },
    "proposal": {
      "type": "object",
      "required": ["agent", "patch_sha256", "patch"],
      "properties": {"agent": {}, "patch_sha256": {}, "patch": {}},
      "additionalProperties": true
    },
    "approval": {
      "type": "object",
      "required": ["actor", "proposal_sha256"],
      "properties": {"actor": {}, "proposal_sha256": {}},
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["before", "after"],
      "properties": {
        "before": {"$ref": "#/$defs/evidence_item"},
        "after": {"$ref": "#/$defs/evidence_item"}
      },
      "additionalProperties": true
    },
    "evidence_item": {
      "type": "object",
      "required": ["status", "observed", "note", "screenshot"],
      "properties": {"status": {}, "observed": {}, "note": {}, "screenshot": {}},
      "additionalProperties": true
    },
    "ticket": {
      "type": "object",
      "required": ["path", "title"],
      "properties": {"path": {"type": "string"}, "title": {"type": "string"}},
      "additionalProperties": true
    },
    "app": {
      "type": "object",
      "required": ["original", "candidate", "patch_sha256"],
      "properties": {"original": {}, "candidate": {}, "patch_sha256": {}},
      "additionalProperties": true
    }
  }
}
