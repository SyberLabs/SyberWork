{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.syberlabs.space/v1alpha1/capability.schema.json",
  "title": "Capability",
  "description": "A typed tool an Agent may propose to use. Protocol sdk.syberlabs.space/v1alpha1. Merges Flyspace's CapabilityManifest (effect class, transport, credential slot, digest, approval excluded from the digest) with cross-platform's typed ports. digest is SHA-256 of canonical JSON of the manifest with digest and approval removed. A manifest never grants itself authority: write and destructive capabilities cannot be auto-approved, and authority to invoke any capability comes from the Agent's grants.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "digest", "label", "inputs", "outputs", "effect", "transport", "auth", "connection", "may_refuse"],
  "properties": {
    "id": {"type": "string", "pattern": "^([a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+|cap_[0-9a-f]{8,64})$"},
    "version": {"type": "integer", "minimum": 1},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "label": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"$ref": "port.schema.json"}},
    "outputs": {"type": "array", "items": {"$ref": "port.schema.json"}},
    "effect": {"enum": ["read", "compute", "write", "destructive"]},
    "transport": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command"],
          "properties": {
            "kind": {"const": "local"},
            "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "mode", "method", "origin"],
          "properties": {
            "kind": {"const": "http"},
            "mode": {"enum": ["browser_direct", "server_broker"]},
            "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
            "origin": {"type": "string", "pattern": "^https://[^/?#]+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "server_id", "origin", "tool"],
          "properties": {
            "kind": {"const": "mcp"},
            "server_id": {"type": "string", "minLength": 1},
            "origin": {"type": "string", "pattern": "^https://[^/?#]+(/[^?#]*)?$"},
            "tool": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "affordance"],
          "properties": {
            "kind": {"const": "browser"},
            "affordance": {"type": "string", "pattern": "^[a-z]+(\\.[a-z]+)+$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "queue", "host_bound"],
          "properties": {
            "kind": {"const": "job"},
            "queue": {"type": "string", "minLength": 1},
            "host_bound": {"type": "boolean"}
          }
        }
      ]
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot"],
      "properties": {
        "slot": {
          "anyOf": [
            {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
            {"type": "null"}
          ]
        }
      }
    },
    "connection": {"enum": ["reader_owned", "server_held", "none"]},
    "may_refuse": {"type": "boolean"},
    "execution": {"enum": ["sync", "async_poll"]},
    "approval": {"enum": ["auto", "pending", "approved", "denied"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_ref"],
      "properties": {
        "source_kind": {"enum": ["openapi", "mcp", "affordance", "registry", "manual"]},
        "source_ref": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["effect"], "properties": {"effect": {"enum": ["write", "destructive"]}}},
      "then": {"properties": {"approval": {"enum": ["pending", "approved", "denied"]}}}
    },
    {
      "if": {"required": ["connection"], "properties": {"connection": {"const": "none"}}},
      "then": {"properties": {"auth": {"properties": {"slot": {"type": "null"}}}}}
    }
  ]
}
