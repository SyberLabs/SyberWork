{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.syberlabs.space/v0alpha1/evolution.schema.json",
  "title": "EvolutionSection",
  "description": "Optional contract section governing provisional candidates from a search provider. Protocol sdk.syberlabs.space/v0alpha1. Unknown fields are refused at publish. The contract, not the provider, fixes scope, operators, budget, checks, and promotion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "operators",
    "budget",
    "evaluation",
    "promotion"
  ],
  "properties": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "exclude": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_diff_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        }
      }
    },
    "operators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_candidates"
      ],
      "properties": {
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_evaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks",
        "required"
      ],
      "properties": {
        "checks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/check"
          }
        },
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          }
        },
        "max_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "roles"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approval_role": {
          "type": "string",
          "minLength": 1
        },
        "target_ref": {
          "type": "string",
          "pattern": "^refs/heads/"
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    }
  }
}
