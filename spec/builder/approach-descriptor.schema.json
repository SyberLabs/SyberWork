{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.syberlabs.space/builder/v0alpha1/approach-descriptor.schema.json",
  "title": "ApproachDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "interaction_model", "architecture", "state_model", "data_model", "primary_abstraction", "dependencies", "expected_strengths", "expected_weaknesses", "distinguishing_claims", "structural_traits"],
  "properties": {
    "intent": {"type": "string", "minLength": 1},
    "interaction_model": {"type": "string", "minLength": 1},
    "architecture": {"type": "string", "minLength": 1},
    "state_model": {"type": "string", "minLength": 1},
    "data_model": {"type": "string", "minLength": 1},
    "primary_abstraction": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "expected_strengths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "expected_weaknesses": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "distinguishing_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "structural_traits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
