{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.syberlabs.space/builder/v0alpha1/integrity-observation.schema.json",
  "title": "IntegrityObservation",
  "description": "Attributed integrity evidence. internal is a self-report. runtime_verified false means the cell stored the claim and did not itself check a signature.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "id", "case_id", "target_kind", "target_id", "claim", "source", "verifier", "independence", "evidence_refs", "result", "digest", "runtime_verified", "at"],
  "properties": {
    "protocol": {"const": "sdk.syberlabs.space/builder/v0alpha1"},
    "id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "generation_id": {"type": ["string", "null"]},
    "target_kind": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "verifier": {"type": "string", "minLength": 1},
    "independence": {"enum": ["internal", "host_verified", "human_reviewed", "external", "signed_external"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "result": {"enum": ["pass", "fail", "concern", "unknown"]},
    "digest": {"type": ["string", "null"]},
    "runtime_verified": {"const": false},
    "at": {"type": "integer", "minimum": 0}
  }
}
