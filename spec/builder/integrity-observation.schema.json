{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.syberlabs.space/builder/v0alpha1/integrity-observation.schema.json",
  "title": "IntegrityObservation",
  "description": "Attributed integrity evidence. independence_claim is what the caller said. verified_independence is set only after a mechanism checks that class. Selection reads the verified class.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "id", "case_id", "target_kind", "target_id", "claim", "source", "verifier", "independence_claim", "verification_status", "verification_method", "verified_independence", "evidence_refs", "result", "digest", "at"],
  "properties": {
    "protocol": {"const": "sdk.syberlabs.space/builder/v0alpha1"},
    "id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "generation_id": {"type": ["string", "null"]},
    "target_kind": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "verifier": {"type": "string", "minLength": 1},
    "independence_claim": {"enum": ["internal", "host_verified", "human_reviewed", "external", "signed_external"]},
    "verification_status": {"enum": ["unverified", "verified", "failed"]},
    "verification_method": {"type": ["string", "null"]},
    "verified_independence": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "result": {"enum": ["pass", "fail", "concern", "unknown"]},
    "digest": {"type": ["string", "null"]},
    "at": {"type": "integer", "minimum": 0}
  }
}
